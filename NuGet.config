<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Supply-chain policy: docs/07-RESOURCE-OPERATIONS-SECURITY.md.
       Exactly one upstream source. Package source mapping prevents a
       future private/internal feed from silently serving a public name. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <!-- Keep restore output inside the repo-independent user cache; do not
         relocate, but do require signature validation on supported hosts. -->
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
